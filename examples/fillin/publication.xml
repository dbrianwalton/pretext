<!-- Publication file for the fill-in blank pairing fixture, serving     -->
<!-- both  main.ptx  and  diagnostics.ptx.                               -->
<!--                                                                     -->
<!-- Deliberately minimal.  The point of this document is what the       -->
<!-- stylesheets do with "fillin" and "evaluate", so anything that       -->
<!-- would add noise to a diff of the output is left at its default.     -->
<!--                                                                     -->
<!-- The  ext  and  gen  directories named below must exist.  They are   -->
<!-- kept in the repository, empty, for exactly that reason.             -->

<publication>

    <source>
        <directories external="ext" generated="gen"/>
    </source>

    <common>
        <!-- Exercises are the whole document, so put each one on the    -->
        <!-- page rather than behind a knowl, where a build can be       -->
        <!-- grepped in one pass.                                        -->
        <fillin textstyle="underline" mathstyle="shade"/>
    </common>

    <html>
        <knowl exercise-inline="no"/>
    </html>

</publication>
